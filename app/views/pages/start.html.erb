<div class="container mx-auto px-4 py-8 max-w-4xl mt-16">

  <h1 class="text-4xl font-bold mb-8">Welcome to Kva Quizzito</h1>

  <div class="flex flex-wrap justify-between space-x-4">
    <!-- Quiz List Link -->
    <div class="p-6 bg-[#274C77] text-white rounded-lg shadow-lg flex-grow">
      <h2 class="text-2xl font-semibold mb-4">Quiz List</h2>
      <%= link_to 'Browse Quizzes', quizzes_path, class: "bg-[#274C77] text-white px-4 py-2 rounded hover:bg-gray-300" %>
    </div>

    <!-- My Quizzes Link -->
    <div class="p-6 bg-[#6B8C90] text-white rounded-lg shadow-lg flex-grow">
      <h2 class="text-2xl font-semibold mb-4">My Quizzes</h2>
      <%= link_to 'Manage My Quizzes', my_quizzes_path, class: "bg-[#6B8C90] text-white px-4 py-2 rounded hover:bg-gray-300" %>
    </div>

    <!-- Highscores Link -->
    <div class="p-6 bg-[#E7ECEF] text-[#274C77] rounded-lg shadow-lg flex-grow">
      <h2 class="text-2xl font-semibold mb-4">Highscores</h2>
      <%= link_to 'View Highscores', highscores_path, class: "bg-[#E7ECEF] text-[#274C77] px-4 py-2 rounded hover:bg-gray-300" %>
    </div>
  </div>

</div>
