<div class="nested-fields mb-4">
  <label for="<%= "#{f.object_name}_question_text" %>" class="block text-lg font-medium text-gray-700">Question:</label>
  <%= f.text_field :question_text, id: "#{f.object_name}_question_text", class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>

  <h4 class="text-lg font-semibold mt-4">Answers</h4>
  <div class="ml-4">
    <%= f.fields_for :answers do |a_form| %>
      <div class="mb-2">
        <%= a_form.text_field :answer_text, placeholder: "Answer text", class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        <%= a_form.check_box :correct, class: "ml-2" %>
        <%= a_form.label :correct, "Correct", class: "ml-2 text-gray-700" %>
      </div>
    <% end %>
  </div>

  <%= link_to "Remove Question", '#', class: "remove-question bg-red-500 text-white px-4 py-2 rounded mt-2" %>
</div>