<div class="nested-fields mb-4">
  <%= f.label :question_text, "Question:", class: "block text-lg font-medium text-gray-700" %>
  <%= f.text_field :question_text, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
  <%= f.hidden_field :_destroy %>
  <%= link_to "Remove", '#', class: "remove_fields bg-red-500 text-white px-4 py-2 rounded mt-2" %>
</div>
