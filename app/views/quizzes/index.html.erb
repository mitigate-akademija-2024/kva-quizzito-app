<div class="container mx-auto px-4 py-8 max-w-4xl mt-16">
  <h1 class="text-3xl font-bold mb-4">Quiz List</h1>

  <table class="min-w-full bg-white shadow-md rounded-lg">
    <thead>
      <tr class="bg-gray-800 text-white">
        <th class="py-2 px-4 text-left">Title</th>
        <th class="py-2 px-4 text-left">Description</th>
        <th class="py-2 px-4 text-left">Created At</th>
        <th class="py-2 px-4 text-left"></th>
      </tr>
    </thead>
    <tbody>
      <% @quizzes.each do |quiz| %>
        <%= render partial: 'quiz_row', locals: { quiz: quiz } %>
      <% end %>
    </tbody>
  </table>

  <div class="mt-6">
    <%= link_to "Create New Quiz", new_quiz_path, class: "bg-[#274C77] text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>
</div>
