<div class="container mx-auto px-4 py-8 max-w-4xl mt-16">
  <% @quizzes.each do |quiz| %>
  <div>
    <h2><%= link_to quiz.title, quiz_path(quiz) %></h2>
    <p><%= quiz.description %></p>
    <% if user_signed_in? %>
      <%= link_to 'Edit', edit_quiz_path(quiz), class: "btn btn-primary" %>
      <%= link_to 'Delete', quiz, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" %>
    <% end %>
  </div>
  <% end %>

  <% if user_signed_in? %>
    <%= link_to 'Create New Quiz', new_quiz_path, class: "btn btn-success" %>
  <% else %>
    <p><%= link_to 'Sign in to create your own quizzes', new_user_session_path %></p>
  <% end %>

</div>