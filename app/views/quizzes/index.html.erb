<div class="container mx-auto px-4 py-8 max-w-4xl">
  <h1 class="text-4xl font-bold mb-8 text-center">Quizzes</h1>

  <div class="text-right mb-6">
    <%= link_to 'New Quiz', new_quiz_path, class: "bg-blue-500 text-white px-4 py-2 rounded shadow hover:bg-blue-600" %>
  </div>

  <div class="grid grid-cols-1 gap-4">
    <% @quizzes.each do |quiz| %>
      <div class="p-6 bg-white border rounded-lg shadow-lg">
        <h2 class="text-2xl font-semibold mb-2"><%= link_to quiz.title, quiz_path(quiz), class: "text-blue-500 hover:underline" %></h2>
        <p class="text-gray-700"><%= quiz.description %></p>
      </div>
    <% end %>
  </div>
</div>