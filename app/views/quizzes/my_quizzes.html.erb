<div class="container mx-auto px-4 py-8 max-w-4xl mt-16">
  <h1 class="text-3xl font-bold mb-4">My Quizzes</h1>

  <% if @quizzes.any? %>
    <table class="min-w-full bg-white shadow-md rounded-lg">
      <thead>
        <tr class="bg-gray-800 text-white">
          <th class="py-2 px-4 text-left">Title</th>
          <th class="py-2 px-4 text-left">Created At</th>
          <th class="py-2 px-4 text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @quizzes.each do |quiz| %>
          <tr class="border-b">
            <td class="py-2 px-4 text-gray-800">
              <%= link_to quiz.title, quiz_path(quiz), class: "hover:underline text-blue-600" %>
            </td>
            <td class="py-2 px-4 text-gray-800">
              <%= quiz.created_at.strftime('%B %d, %Y') %>
            </td>
            <td class="py-2 px-4">
              <%= link_to 'View', quiz_path(quiz), class: "text-blue-600 hover:underline mr-4" %>
              <%= link_to 'Edit', edit_quiz_path(quiz), class: "text-green-600 hover:underline mr-4" %>
              <%= link_to 'Delete', confirm_delete_quiz_path(quiz), class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-700 mt-6">You haven't created any quizzes yet.</p>
  <% end %>

  <div class="mt-6">
    <%= link_to "Create New Quiz", new_quiz_path, class: "bg-[#274C77] text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>
</div>
