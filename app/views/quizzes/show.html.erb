<div class="container mx-auto px-4 py-8 max-w-4xl mt-16">
  <!-- Quiz Title -->
  <h1 class="text-3xl font-bold mb-4"><%= @quiz.title %></h1>

  <!-- Quiz Creator -->
  <p class="text-lg text-gray-700 mb-2">
    <strong>Created by:</strong> <%= @quiz.user.email %>
  </p>

  <!-- Quiz Description -->
  <p class="text-lg text-gray-700 mb-8">
    <strong>Description:</strong> <%= @quiz.description %>
  </p>

  <!-- Questions Section -->
  <h2 class="text-2xl font-semibold mb-4">Questions</h2>
  <div class="bg-white shadow-md rounded-lg p-4 mb-6">
    <% @quiz.questions.each do |question| %>
      <div class="mb-6">
        <p class="text-xl font-medium text-blue-600"><%= question.question_text %></p>
        <ul class="list-disc ml-8">
          <% question.answers.each do |answer| %>
            <li class="mt-1"><%= answer.answer_text %></li>
              <% if user_signed_in? && current_user.id == @quiz.user.id && answer.correct %>
                <span class="text-green-500 font-semibold">(Correct)</span>
              <% end %>
          <% end %>
        </ul>
      </div>
      <% if user_signed_in? && current_user.id == @quiz.user.id %>
      <% end %>
    <% end %>
  </div>

  <!-- Feedback Form -->
  <h2 class="text-2xl font-semibold mb-4 mt-8">Leave Feedback</h2>
  <%= form_with(model: [ @quiz, Feedback.new ], local: true) do |form| %>
    <div class="mb-4">
      <%= form.text_area :content, rows: 5, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= form.submit "Submit Feedback", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600", data: { turbo: false } %>
    </div>
  <% end %>

  <!-- Display Feedback -->
  <h2 class="text-2xl font-semibold mb-4 mt-8">Feedback</h2>
  <% @quiz.feedbacks.each do |feedback| %>
    <div class="mb-4 p-4 border rounded-md">
      <p><strong><%= feedback.user.username %>:</strong></p>
      <p><%= feedback.content %></p>
    </div>
  <% end %>

  <!-- Action Buttons -->
  <div class="flex space-x-4">
    <%= link_to "Edit this quiz", edit_quiz_path(@quiz), class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    <%= link_to "Back to quizzes", quizzes_path, class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
    <%= link_to 'Delete this quiz', confirm_delete_quiz_path(@quiz), class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700" %>
  </div>
</div>
