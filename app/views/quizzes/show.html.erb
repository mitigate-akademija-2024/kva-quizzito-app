<div class="container mx-auto px-4 py-8 max-w-4xl mt-16">

  <h1 class="text-3xl font-bold mb-4"><%= @quiz.title %></h1>
  <p class="text-lg text-gray-700"><%= @quiz.description %></p>

  <h2 class="text-2xl font-semibold mt-8">Questions</h2>
  <ul>
    <% @questions.each do |question| %>
      <div class="mb-6">
        <h2 class="text-2xl font-semibold"><%= question.question_text %></h2>

        <h3 class="text-lg font-semibold mt-4">Answers</h3>
        <ul class="ml-4 list-disc">
          <% question.answers.each do |answer| %>
            <li class="mt-2">
              <%= form_with(model: [question, UserAnswer.new], url: quiz_question_user_answers_path(@quiz, question), local: true, data: { turbo: false }) do |form| %>
                <%= form.radio_button :answer_id, answer.id %>
                <%= form.label :answer_id, answer.answer_text %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </ul>

  <div class="mt-8">
    <%= form_with(url: submit_answers_quiz_path(@quiz), method: :post, local: true, data: { turbo: false }) do |form| %>
  <% @quiz.questions.each do |question| %>
    <div class="mb-4">
      <h3 class="text-lg font-semibold"><%= question.question_text %></h3>
      <% question.answers.each do |answer| %>
        <div class="mt-2">
          <%= form.radio_button "answers[#{question.id}]", answer.id, id: "answer_#{answer.id}" %>
          <%= form.label "answer_#{answer.id}", answer.answer_text %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= form.submit 'Submit Answers', class: "bg-blue-500 text-white px-4 py-2 rounded" %>
<% end %>

    <div class="mt-8">
      <%= button_to 'Reset Answers', reset_answers_quiz_path(@quiz), method: :delete, data: { turbo: false }, class: "bg-red-500 text-white px-4 py-2 rounded" %>
    </div>
  </div>

</div>
