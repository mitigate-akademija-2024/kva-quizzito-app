<h1 class="text-3xl font-bold mb-4">Quiz Results: <%= @quiz.title %></h1>

<p class="text-lg">You got <%= @correct_answers_count %> out of <%= @quiz.questions.count %> questions correct.</p>

<h2 class="text-2xl font-semibold mt-8">Review Your Answers</h2>
<ul class="mt-4">
  <% @quiz.questions.each do |question| %>
    <li class="mb-6">
      <h3 class="text-xl"><%= question.question_text %></h3>

      <p class="mt-2"><strong>Your Answer:</strong> <%= @user_answers.find { |ua| ua.question_id == question.id }.answer.question_text %></p>

      <% if @user_answers.find { |ua| ua.question_id == question.id }.answer.correct %>
        <p class="text-green-500">Correct!</p>
      <% else %>
        <p class="text-red-500">Incorrect. The correct answer was: <%= question.answers.find_by(correct: true).question_text %></p>
      <% end %>
    </li>
  <% end %>
</ul>

<div class="mt-8">
  <%= link_to 'Back to Quizzes', quizzes_path, class: "bg-blue-500 text-white px-4 py-2 rounded" %>
</div>
