<div class="container mx-auto px-4 py-8 max-w-4xl mt-16">
  <h1 class="text-4xl font-bold mb-8">Profile</h1>

  <div class="bg-white p-6 rounded-lg shadow-lg">
    <h2 class="text-2xl font-semibold mb-4">User Information</h2>
    <p><strong>Username:</strong> <%= @user.username %></p>
    <p><strong>Member Since:</strong> <%= @user.created_at.strftime("%B %d, %Y") %></p>
    <p><strong>Email:</strong> <%= @user.email %></p>
        <%= form_with model: @user, url: user_registration_path, local: true do |f| %>
          <div class="actions">
            <%= f.submit "Update Profile", data: { turbo: false } %>
          </div>
        <% end %>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-lg mt-8">
    <h2 class="text-2xl font-semibold mb-4">Your Quizzes</h2>
    <% if @quizzes.any? %>
      <ul>
        <% @quizzes.each do |quiz| %>
          <li class="mb-2"><%= link_to quiz.title, quiz_path(quiz), class: "text-blue-500 hover:underline" %></li>
        <% end %>
      </ul>
    <% else %>
      <p>You haven't created any quizzes yet.</p>
    <% end %>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-lg mt-8">
    <h2 class="text-2xl font-semibold mb-4">Feedback Received</h2>
    <% if @received_feedbacks.any? %>
      <ul>
        <% @received_feedbacks.each do |feedback| %>
          <li class="mb-2">
            <strong>Quiz:</strong> <%= link_to feedback.quiz.title, quiz_path(feedback.quiz), class: "text-blue-500 hover:underline" %><br>
            <strong>Feedback:</strong> <%= feedback.content %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>You haven't received any feedback yet.</p>
    <% end %>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-lg mt-8">
    <h2 class="text-2xl font-semibold mb-4">Your Scores</h2>
    <% if @scores.any? %>
      <ul>
        <% @scores.each do |score| %>
          <li class="mb-2">
            Quiz: <%= link_to score.quiz.title, quiz_path(score.quiz), class: "text-blue-500 hover:underline" %> - 
            Score: <%= score.score %>%
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>You haven't taken any quizzes yet.</p>
    <% end %>
  </div>

</div>
