<!DOCTYPE html>
<html>
  <head>
    <title>Kva Quizzito</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload' %>
  </head>

  <body class="bg-gray-100">
    <!-- Navigation Bar -->

    <nav class="bg-gray-800 p-4 shadow-lg fixed top-0 left-0 w-full z-10">
      <div class="container mx-auto flex justify-between items-center">
        <!-- Left side navigation links -->
        <ul class="flex space-x-4 text-white">
          <li><%= link_to 'Home', root_path, class: "hover:underline" %></li>
          <li><%= link_to 'Quiz List', quizzes_path, class: "hover:underline" %></li>
          <% if user_signed_in? %>
            <li><%= link_to 'My Quizzes', my_quizzes_path, class: "hover:underline" %></li>
            <li><%= link_to 'My Feedbacks', my_feedbacks_path, class: "hover:underline" %></li>
          <% end %>
          <li><%= link_to 'Highscores', highscores_path, class: "hover:underline" %></li>
        </ul>

        <!-- Right side profile, search, and logout -->
        <div class="flex space-x-4 text-white items-center">
          <!-- Search Form -->
          <div>
            <%= form_with(url: search_quizzes_path, method: :get, local: true, data: { turbo: false }) do |form| %>
              <%= form.text_field :query, placeholder: "Search quizzes...", class: "rounded p-2 text-black" %>
              <%= form.submit "Search", class: "bg-gray-700 text-white p-2 rounded" %>
            <% end %>
          </div>

          <ul class="flex space-x-4">
            <% if user_signed_in? %>
              <li><%= link_to (current_user.username || "Profile"), user_profile_path, class: "hover:underline" %></li>
              
              <li>
                <%= form_with url: destroy_user_session_path, method: :delete, class: "inline", data: { turbo: false } do %>
                  <%= submit_tag 'Logout', class: "hover:underline bg-transparent border-0 text-white cursor-pointer" %>
                <% end %>
              </li>
            <% else %>
              <li><%= link_to 'Login', new_user_session_path, class: "hover:underline", data: { turbo: false } %></li>
              <li><%= link_to 'Sign Up', new_user_registration_path, class: "hover:underline", data: { turbo: false } %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mx-auto px-4 py-8">
      <%= yield %>
    </div>
  </body>
</html>
